[Unit]
Description=SOCO AI hair try-on (Perfect Corp / YouCam)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/soco-tryon
EnvironmentFile=/opt/soco-tryon/.env
ExecStart=/opt/soco-tryon/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8088
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
