[Unit]
Description=SOCO AI hair try-on (Perfect Corp / YouCam)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/soco-tryon
EnvironmentFile=/opt/soco-tryon/.env
# Local only — nginx exposes :8088 (legacy) and :80/:443 (domain)
ExecStart=/opt/soco-tryon/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 18088 --workers 1
Restart=always
RestartSec=3
MemoryMax=1400M
MemoryHigh=1100M

[Install]
WantedBy=multi-user.target
