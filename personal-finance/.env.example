# Пароль для входа на сайт (обязателен на сервере)
FINANCE_PASSWORD=replace_with_a_long_password

# Секрет подписи cookie. Если пусто — создаётся в data/.session_secret
FINANCE_SESSION_SECRET=

# Порт веб-сервера
FINANCE_PORT=8090

# Telegram: отчёт в ГРУППУ после разнесения переводов (не в чаты салона)
FINANCE_TELEGRAM_ENABLED=1
FINANCE_TELEGRAM_BOT_TOKEN=replace_with_your_bot_token
FINANCE_TELEGRAM_CHAT_ID=replace_with_group_chat_id

# Ссылка на сайт в сообщении «разнесите переводы» (необязательно)
FINANCE_SITE_URL=https://kassa.rost-i-razvitie.ru

# Домен Кассы. Корень rost-i-razvitie.ru не занимаем — там сайт центра на Vigbo.
FINANCE_DOMAIN=kassa.rost-i-razvitie.ru

# Папка Google Drive с выписками (ссылка или ID). Имена файлов не важны — даты из операций.
FINANCE_DRIVE_FOLDER=https://drive.google.com/drive/folders/1VIxQOYkI8T5kGaO8EuzJEduuQBnLyRgj
# FINANCE_DRIVE_ENABLED=off
